ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Fal.ai (image generation for illustrations)
FAL_API_KEY=your-fal-api-key-here

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=infographycs-media
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta / Instagram
META_ACCESS_TOKEN=         # Long-lived token, renovar cada ~60 días
META_INSTAGRAM_USER_ID=    # Instagram Business Account ID
META_APP_ID=
META_APP_SECRET=

# Telegram (revisión humana)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # Tu chat ID personal

# Fuentes de datos
SEMANTIC_SCHOLAR_API_KEY=  # Free: https://api.semanticscholar.org/

# Configuración del pipeline
POSTS_PER_DAY=4
MIN_QUEUE_APPROVED=10      # Mínimo items aprobados antes de alertar
REVIEW_TIMEOUT_HOURS=4     # Auto-aprobar tras X horas sin respuesta
AUTO_APPROVE_AFTER_TIMEOUT=false

# Render service
PUPPETEER_SERVICE_URL=http://localhost:3001
RENDER_TIMEOUT_MS=30000

# n8n (si diferente de localhost)
N8N_URL=http://localhost:5678
N8N_API_KEY=
