{
  "name": "Queue Health Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://api:8000/api/queue/stats",
        "options": {}
      },
      "id": "2",
      "name": "Get Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.approved_count }}",
              "operation": "smaller",
              "value2": 3
            }
          ]
        }
      },
      "id": "3",
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "=Alert: Only {{ $json.approved_count }} approved items in queue! (Threshold: 3)",
        "additionalFields": {}
      },
      "id": "4",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [800, 200]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [ [ { "node": "Get Stats", "type": "main", "index": 0 } ] ]
    },
    "Get Stats": {
      "main": [ [ { "node": "IF", "type": "main", "index": 0 } ] ]
    },
    "IF": {
      "main": [
        [ { "node": "Telegram", "type": "main", "index": 0 } ],
        []
      ]
    }
  },
  "active": false,
  "settings": {}
}
